## Windows Android local.properties Example
## Copy this file or edit frontend/android/local.properties on your Windows machine:
## Note: In .properties files, backslashes must be escaped (\\) or forward slashes (/) should be used.

## Replace USERNAME with your Windows username, e.g. C:\\Users\\koushik\\AppData\\Local\\Android\\Sdk
sdk.dir=C:\\Users\\USERNAME\\AppData\\Local\\Android\\Sdk

## Replace with your Flutter installation folder on Windows, e.g. C:\\flutter or C:\\src\\flutter
flutter.sdk=C:\\flutter

flutter.buildMode=debug
flutter.versionName=1.0.0
flutter.versionCode=1
