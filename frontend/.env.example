# ============================================================
#  MemoryVerse Frontend — Environment Variables
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env to version control.
# ============================================================

# Backend API base URL shared by platforms when no platform override is set.
# Android emulator: 10.0.2.2 reaches the development machine.
# iOS simulator / desktop: 127.0.0.1 reaches the development machine.
# Physical phones: use the development machine's LAN IP in the platform override.
API_BASE_URL=http://10.0.2.2:8000/api/v1
# Leave overrides blank for emulator/simulator defaults. For physical devices,
# set the matching override to http://<development-machine-LAN-IP>:8000/api/v1.
API_BASE_URL_ANDROID=
API_BASE_URL_IOS=
API_BASE_URL_WEB=

# For physical-device testing, start the backend with
# MEMORYVERSE_BIND_HOST=0.0.0.0 so it accepts connections from your LAN.

# Supabase (required — same project as backend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Google Sign-In (optional — needed for Google OAuth)
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
