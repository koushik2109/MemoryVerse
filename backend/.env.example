# ============================================================
#  MemoryVerse Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env to version control.
# ============================================================

# Supabase Project Settings (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT (optional — override the default for production)
JWT_SECRET=change_this_to_a_long_random_secret_in_production
ALGORITHM=HS256

# AI / LLM Configuration (optional)
# Set LLM_PROVIDER to: openai | gemini | none
# If LLM_API_KEY is unset or LLM_PROVIDER=none, the AI chat
# returns an intelligent memory-context fallback instead of LLM output.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
AI_ENABLED=true

# Server (optional)
ENVIRONMENT=development
