PROJECT_NAME="MemoryVerse API"
ENVIRONMENT="development"
SUPABASE_URL="https://your_project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
JWT_SECRET="your_jwt_secret"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="postgres"
POSTGRES_HOST="your_db_host"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://postgres:your_postgres_password@your_db_host:5432/postgres"

# Email & OTP
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=465
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_smtp_password"
OTP_HASH_SECRET="your_otp_hash_secret"
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Redis Rate Limiting & Storage
UPSTASH_REDIS_REST_URL="https://your_redis_url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_token"
