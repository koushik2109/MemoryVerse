PROJECT_NAME="MemoryVerse API"
ENVIRONMENT="development"

# Supabase Credentials
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

JWT_SECRET="change_me_to_a_secure_random_secret_in_production"
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Optional local PostgreSQL connection settings
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_me"
POSTGRES_DB="memoryverse"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Email and one-time-password settings
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USERNAME="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"
OTP_HASH_SECRET="change_me_to_a_separate_random_secret"
OTP_EXPIRE_MINUTES="10"
OTP_MAX_ATTEMPTS="5"

# Optional Redis and AI-engine service settings
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
AI_ENGINE_URL="http://localhost:8001"
AI_ENGINE_SHARED_SECRET="change_me_to_a_shared_service_secret"

# AI / LLM Configuration (OpenRouter / Gemini / OpenAI)
LLM_PROVIDER="openrouter"
LLM_API_KEY="sk-or-v1-your-openrouter-api-key-here"
LLM_MODEL="nvidia/nemotron-3.5-lightning:free"

# Optional: Replicate API Key for external AI Video models (Leave empty for built-in AI Motion Synthesizer)
REPLICATE_API_KEY=""
